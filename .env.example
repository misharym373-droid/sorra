# انسخ هذا الملف إلى .env وضع مفتاحك. لا ترفع ملف .env لأي مكان عام.
ANTHROPIC_API_KEY=ضع_مفتاحك_هنا

# اختياري
PORT=3000
MODEL=claude-sonnet-5
FAST_MODEL=claude-haiku-4-5-20251001

# اختياري لكن مهم إذا رفعت الخادم على الإنترنت: رمز سري تكتبه أيضًا في التطبيق
# (الملف الشخصي ← ربط الذكاء الاصطناعي). بدونه أي أحد يعرف الرابط يقدر يستخدم مفتاحك.
APP_TOKEN=

# اختياري: فقط إذا كان ملف التطبيق مستضافًا في موقع مختلف عن الخادم
ALLOWED_ORIGIN=

# حد الطلبات لكل جهاز في الدقيقة
RATE_PER_MIN=30
